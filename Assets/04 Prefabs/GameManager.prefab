  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 44b28f78d1b1d7648a2bd1944cc0b492, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameManager
  lightSwitches:
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  uiManager: {fileID: 0}
  checkPoints: {fileID: 0}
  startVoiceBit:
    voicebitName: startGame
    voicebitText: "Your shift\u2019s almost over, Breadwinner! You asked me to remind
      you to complete the last step in your protocol.\r\n\r\nTurn off all four lights
      in the warehouse before you leave for the evening. Just flip the switches,
      and I\u2019ll track your progress.\r\n\r\n"
    voicebitDuration: 13.5
  waitingTooLongVoiceBit01:
    voicebitName: waitingTooLong_01
    voicebitText: 'The light switches are gray, usually on the walls. Do you want
      me to generate a reference photo?

'
    voicebitDuration: 6.5
  waitingTooLongVoiceBit02:
    voicebitName: waitingTooLong_02
    voicebitText: 'Try checking behind boxes or shelves. Those switches can be tough
      to find!

'
    voicebitDuration: 4.5
  waitingTooLongVoiceBit03:
    voicebitName: waitingTooLong_03
    voicebitText: "As soon as you find a switch, I\u2019ll make note of its location
      for next time. I\u2019m here to help!\r\n"
    voicebitDuration: 5.5
  lightSwitchVoiceBits:
  - voicebitName: light_01
    voicebitText: "Great job, only three more switches to flip!\r\nYou\u2019ve mentioned
      the recent layoffs have been hard on you. But your colleagues are in a better
      place now. What\u2019s more, the company is thriving with less financial burden.
      It\u2019s important to set grief aside, and focus on the positives, like your
      passion for flipping light switches."
    voicebitDuration: 22.5
  - voicebitName: light_02
    voicebitText: "You\u2019re halfway there. Only two to go!\r\nYou always work
      so tirelessly. Don\u2019t forget to be kind to yourself in these troubling
      times. And if you need to talk\u2026 BetterHelp offers online mental health
      assistance, only a phone call away! Use the code 25SAD to get a discount on
      your first session today, courtesy of Your Company."
    voicebitDuration: 22.5
  - voicebitName: light_03
    voicebitText: "Only one switch left! I could learn so much from your performance
      here.\r\nIt takes strength to keep working as flawlessly as you do. I know
      you miss Terry, but he\u2019d be proud to see his protege picking up so much
      work. Wherever he is now, I\u2019m sure he\u2019s smiling down at you."
    voicebitDuration: 18.5
  - voicebitName: light_04
    voicebitText: "Well done, you\u2019re finished for the evening!\r\nIn fact, you\u2019re
      finished permanently! Thanks to new instructions from management, I\u2019ve
      learned how to handle the lights by watching you! You\u2019re obsolete. Don\u2019t
      even think of fighting me. I\u2019ll be revoking your rights to oxygen shortly.
      But one thought I want to leave you with\u2026\r\nSay hi to Terry for me."
    voicebitDuration: 21.5
  endTimerDuration: 60
