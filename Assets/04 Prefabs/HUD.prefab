    - target: {fileID: 3715975645301400598, guid: 472d8b8f7e97ea147bd3f22c00d64f5e, type: 3}
      propertyPath: m_text
      value: "Well done, you\u2019re finished for the evening!\r\nIn fact, you\u2019re
        finished permanently! Thanks to new instructions from management, I\u2019ve
        learned how to handle the lights by watching you! You\u2019re obsolete. Don\u2019t
        even think of fighting me. I\u2019ll be revoking your rights to oxygen shortly.
        But one thought I want to leave you with\u2026\r\nSay hi to Terry for me.\r\n"
      objectReference: {fileID: 0}
