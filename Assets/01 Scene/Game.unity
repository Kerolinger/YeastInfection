      value: 
      objectReference: {fileID: 195971296}
    - target: {fileID: 5695657209909453994, guid: cc8af863cee34f74d850dcf87cc74af2, type: 3}
      propertyPath: 'lightSwitches.Array.data[3]'
      value: 
      objectReference: {fileID: 1318781893}
    - target: {fileID: 5695657209909453994, guid: cc8af863cee34f74d850dcf87cc74af2, type: 3}
