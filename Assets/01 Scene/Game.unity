      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 5695657209909453994, guid: cc8af863cee34f74d850dcf87cc74af2, type: 3}
      propertyPath: waitingTooLongVoiceBit01.voicebitName
      value: waitingTooLong_01
      objectReference: {fileID: 0}
    - target: {fileID: 5695657209909453994, guid: cc8af863cee34f74d850dcf87cc74af2, type: 3}
      propertyPath: waitingTooLongVoiceBit01.voicebitText
      value: 'The light switches are gray, usually on the walls. Do you want me to
        generate a reference photo?

'
      objectReference: {fileID: 0}
    - target: {fileID: 5695657209909453994, guid: cc8af863cee34f74d850dcf87cc74af2, type: 3}
      propertyPath: waitingTooLongVoiceBit02.voicebitName
      value: waitingTooLong_02
      objectReference: {fileID: 0}
    - target: {fileID: 5695657209909453994, guid: cc8af863cee34f74d850dcf87cc74af2, type: 3}
      propertyPath: waitingTooLongVoiceBit02.voicebitText
      value: 'Try checking behind boxes or shelves. Those switches can be tough to
        find!

'
      objectReference: {fileID: 0}
    - target: {fileID: 5695657209909453994, guid: cc8af863cee34f74d850dcf87cc74af2, type: 3}
      propertyPath: waitingTooLongVoiceBit03.voicebitName
      value: waitingTooLong_03
      objectReference: {fileID: 0}
    - target: {fileID: 5695657209909453994, guid: cc8af863cee34f74d850dcf87cc74af2, type: 3}
      propertyPath: waitingTooLongVoiceBit03.voicebitText
      value: "As soon as you find a switch, I\u2019ll make note of its location for
        next time. I\u2019m here to help!\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5695657209909453994, guid: cc8af863cee34f74d850dcf87cc74af2, type: 3}
