    - target: {fileID: 5695657209909453994, guid: cc8af863cee34f74d850dcf87cc74af2, type: 3}
      propertyPath: startVoiceBit.voicebitText
      value: "Your shift\u2019s almost over, Breadwinner! You asked me to remind
        you to complete the last step in your protocol.\r\n\r\nTurn off all four
        lights in the warehouse before you leave for the evening. Just flip the switches,
        and I\u2019ll track your progress.\r\n\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5695657209909453994, guid: cc8af863cee34f74d850dcf87cc74af2, type: 3}
